# Environment Configuration for Network Sniffer Dashboard

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-change-this

# Azure Configuration
WEBSITE_PORT=5000
WEBSITE_INSTANCE_ID=0

# Application Settings
LOG_LEVEL=INFO
MAX_HISTORY=2000

# Security Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Database (if needed in future)
DATABASE_URL=

# API Keys (if needed)
API_KEY=
